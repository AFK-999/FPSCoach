@echo off
rem FPS Coach update: curve-file compatibility and optional AI chat.
rem Place this file in the project root beside pyproject.toml, then double-click it.
setlocal
set "FPSCOACH_SELF=%~f0"
set "FPSCOACH_PS1=%TEMP%\FPSCoach-Update-%RANDOM%-%RANDOM%.ps1"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText($env:FPSCOACH_SELF); $m='# '+'FPSCOACH_POWERSHELL_BEGIN'; $i=$s.LastIndexOf($m); if($i -lt 0){exit 2}; [IO.File]::WriteAllText($env:FPSCOACH_PS1,$s.Substring($i+$m.Length),[Text.UTF8Encoding]::new($false))"
if errorlevel 1 (echo Could not unpack the updater.& del "%FPSCOACH_PS1%" >nul 2>&1& exit /b 1)
powershell -NoProfile -ExecutionPolicy Bypass -File "%FPSCOACH_PS1%" -ProjectRoot "%~dp0."
set "FPSCOACH_EXIT=%ERRORLEVEL%"
del "%FPSCOACH_PS1%" >nul 2>&1
if not "%FPSCOACH_EXIT%"=="0" pause
exit /b %FPSCOACH_EXIT%
# FPSCOACH_POWERSHELL_BEGIN
param([Parameter(Mandatory=$true)][string]$ProjectRoot)

$ErrorActionPreference = 'Stop'
# A trailing backslash before a closing CMD quote can be passed to PowerShell as a
# literal quote on some Windows configurations. Remove only accidental wrapper
# quotes, then normalize the project directory. The BAT also appends a safe dot.
$ProjectRoot = $ProjectRoot.Trim().Trim([char]34)
$ProjectRoot = [IO.Path]::GetFullPath($ProjectRoot)
$Required = @(
    'pyproject.toml',
    'python\fps_coach\ui\main_window.py',
    'python\fps_coach\ui\styles.py'
)
foreach ($Relative in $Required) {
    if (-not (Test-Path -LiteralPath (Join-Path $ProjectRoot $Relative) -PathType Leaf)) {
        Write-Host "ERROR: This does not look like the FPS Coach project root." -ForegroundColor Red
        Write-Host "Missing: $Relative"
        exit 1
    }
}

$MainWindow = Get-Content -LiteralPath (Join-Path $ProjectRoot 'python\fps_coach\ui\main_window.py') -Raw
if ($MainWindow -notmatch 'class RecommendationPage' -or $MainWindow -notmatch 'class MainWindow') {
    Write-Host 'ERROR: The existing UI is not a compatible FPS Coach foundation.' -ForegroundColor Red
    exit 1
}

