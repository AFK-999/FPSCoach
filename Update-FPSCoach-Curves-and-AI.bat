'@

$Files = @(
    'README.md',
    'docs\architecture.md',
    'python\fps_coach\ai_chat.py',
    'python\fps_coach\curve_io.py',
    'python\fps_coach\ui\main_window.py',
    'python\fps_coach\ui\styles.py'
)
$TempRoot = Join-Path ([IO.Path]::GetTempPath()) ('FPSCoach-Update-' + [Guid]::NewGuid().ToString('N'))
$ZipPath = Join-Path $TempRoot 'update.zip'
$ExtractRoot = Join-Path $TempRoot 'payload'
$Stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$BackupRoot = Join-Path $ProjectRoot ('.fpscoach-update-backups\' + $Stamp)
$Created = [Collections.Generic.List[string]]::new()
$BackedUp = [Collections.Generic.List[string]]::new()

try {
    New-Item -ItemType Directory -Path $TempRoot, $ExtractRoot -Force | Out-Null
    $Bytes = [Convert]::FromBase64String(($Payload -replace '\s', ''))
    [IO.File]::WriteAllBytes($ZipPath, $Bytes)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [IO.Compression.ZipFile]::ExtractToDirectory($ZipPath, $ExtractRoot)

    foreach ($Relative in $Files) {
        $Source = Join-Path $ExtractRoot $Relative
        $Destination = Join-Path $ProjectRoot $Relative
        if (-not (Test-Path -LiteralPath $Source -PathType Leaf)) {
            throw "Embedded update is missing $Relative"
        }
        if (Test-Path -LiteralPath $Destination -PathType Leaf) {
            $Backup = Join-Path $BackupRoot $Relative
            New-Item -ItemType Directory -Path (Split-Path $Backup) -Force | Out-Null
            Copy-Item -LiteralPath $Destination -Destination $Backup -Force
            $BackedUp.Add($Relative)
        } else {
            $Created.Add($Relative)
        }
        New-Item -ItemType Directory -Path (Split-Path $Destination) -Force | Out-Null
        Copy-Item -LiteralPath $Source -Destination $Destination -Force
    }

    $Python = $null
    $VenvPython = Join-Path $ProjectRoot '.venv\Scripts\python.exe'
    if (Test-Path -LiteralPath $VenvPython -PathType Leaf) {
        $Python = $VenvPython
    } else {
        $Command = Get-Command python -ErrorAction SilentlyContinue
        if ($Command) { $Python = $Command.Source }
    }
    if ($Python) {
        & $Python -m compileall -q (Join-Path $ProjectRoot 'python\fps_coach')
        if ($LASTEXITCODE -ne 0) { throw 'Python syntax validation failed.' }
    } else {
        Write-Host 'Python was not found; files were installed without syntax validation.' -ForegroundColor Yellow
    }

    Write-Host ''
    Write-Host 'FPS Coach update completed successfully.' -ForegroundColor Green
    Write-Host 'Added: .ccurve/.cc4 import and export with UI compatibility selection.'
    Write-Host 'Added: local Ollama and online OpenAI-compatible AI chat settings.'
    if ($BackedUp.Count -gt 0) { Write-Host "Backup: $BackupRoot" }
    Write-Host 'No model weights were downloaded and no API key was stored.'
    exit 0
}
catch {
    Write-Host ''
    Write-Host ("Update failed: " + $_.Exception.Message) -ForegroundColor Red
    Write-Host 'Restoring changed files...' -ForegroundColor Yellow
    foreach ($Relative in $BackedUp) {
        $Backup = Join-Path $BackupRoot $Relative
        $Destination = Join-Path $ProjectRoot $Relative
        if (Test-Path -LiteralPath $Backup) {
            New-Item -ItemType Directory -Path (Split-Path $Destination) -Force | Out-Null
            Copy-Item -LiteralPath $Backup -Destination $Destination -Force
        }
    }
    foreach ($Relative in $Created) {
        $Destination = Join-Path $ProjectRoot $Relative
        if (Test-Path -LiteralPath $Destination) { Remove-Item -LiteralPath $Destination -Force }
    }
    exit 1
}
finally {
    if (Test-Path -LiteralPath $TempRoot) {
        Remove-Item -LiteralPath $TempRoot -Recurse -Force -ErrorAction SilentlyContinue
    }
}
