diff --git a/python/fps_coach/env_repair.py b/python/fps_coach/env_repair.py
new file mode 100644
index 0000000..c4711d1
--- /dev/null
+++ b/python/fps_coach/env_repair.py
@@ -0,0 +1,123 @@
+"""Automatic environment self-repair for FPS Coach.
+
+The app installs itself as a pip *editable* install that records the project's
+absolute path. When the whole project folder is MOVED or RENAMED, that recorded
+path goes stale and imports/launches can break (this is what
+``Repair-FPSCoach-Path-and-Run.bat`` fixes manually).
+
+:func:`ensure_environment` performs the same check automatically at startup. It
+is deliberately lightweight: in the normal case (nothing moved) it does nothing
+and returns immediately. It only reinstalls the editable package when it detects
+the project has actually moved. It never raises - a failed repair just returns
+False so the caller can decide what to do.
+
+Handles paths containing spaces and non-ASCII characters (uses ``sys.executable``
+and pathlib throughout; no shell string building).
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+MARKER_NAME = ".fpscoach_env.json"
+
+
+def project_root() -> Path:
+    """Project root = two levels up from python/fps_coach/env_repair.py."""
+    return Path(__file__).resolve().parents[2]
+
+
+def _marker_path() -> Path:
+    return project_root() / MARKER_NAME
+
+
+def _recorded_root() -> str | None:
+    marker = _marker_path()
+    if not marker.exists():
+        return None
+    try:
+        return json.loads(marker.read_text(encoding="utf-8")).get("root")
+    except Exception:
+        return None
+
+
+def _record_root() -> None:
+    try:
+        _marker_path().write_text(
+            json.dumps({"root": str(project_root())}, ensure_ascii=False, indent=2),
+            encoding="utf-8",
+        )
+    except Exception:
+        pass
+
+
+def package_location_is_stale() -> bool:
+    """True if the imported ``fps_coach`` package resolves somewhere other than
+    this project's ``python`` directory (e.g. a lingering old copy after a move).
+    """
+    try:
+        import fps_coach
+
+        imported_from = Path(fps_coach.__file__).resolve().parents[1]
+        expected = (project_root() / "python").resolve()
+        return imported_from != expected
+    except Exception:
+        return True
+
+
+def needs_repair() -> bool:
+    recorded = _recorded_root()
+    moved = recorded is not None and Path(recorded) != project_root()
+    return moved or package_location_is_stale()
+
+
+def repair(python_exe: str | None = None, verbose: bool = True) -> bool:
+    """Re-point the editable install at the current project folder.
+
+    Mirrors Repair-FPSCoach-Path-and-Run.bat: ``pip install --editable . --no-deps``.
+    Returns True on success.
+    """
+    root = project_root()
+    exe = python_exe or sys.executable
+    if verbose:
+        print(f"[fps_coach] Project folder changed - repairing editable install for: {root}")
+    try:
+        subprocess.run(
+            [exe, "-m", "pip", "install", "--editable", str(root), "--no-deps"],
+            check=True,
+            cwd=str(root),
+        )
+    except Exception as exc:  # noqa: BLE001 - never let repair crash the app
+        if verbose:
+            print(f"[fps_coach] Automatic repair failed: {exc}", file=sys.stderr)
+            print("[fps_coach] Run 'Setup and Run.bat' for a full rebuild.", file=sys.stderr)
+        return False
+    _record_root()
+    if verbose:
+        print("[fps_coach] Repair complete.")
+    return True
+
+
+def ensure_environment(verbose: bool = True) -> bool:
+    """Check the local environment and auto-repair if the folder moved/renamed.
+
+    Call this once at startup, before loading heavy modules/UI. Fast no-op when
+    nothing has changed. Never raises.
+    """
+    try:
+        if needs_repair():
+            ok = repair(verbose=verbose)
+            if ok:
+                _record_root()
+            return ok
+        _record_root()
+        return True
+    except Exception:  # noqa: BLE001
+        return False
+
+
+if __name__ == "__main__":
+    raise SystemExit(0 if ensure_environment() else 1)
diff --git a/scripts/build.ps1 b/scripts/build.ps1
new file mode 100644
index 0000000..5b70c29
--- /dev/null
+++ b/scripts/build.ps1
@@ -0,0 +1,69 @@
+<#
+.SYNOPSIS
+    Build an FPS Coach distributable installer in one of two flavors.
+
+.DESCRIPTION
+    lite  - Foundation build. No AI models or runtime bundled. The user installs
+            Ollama and pulls a model themselves (the app auto-pulls on first chat).
+    full  - Embeds the Ollama runtime + Qwen 3 1.7B weights so the AI works out
+            of the box.
+
+    Steps: ensure venv -> install project + PyInstaller -> stamp build_info ->
+    freeze with PyInstaller -> (full only) stage AI assets -> compile the Inno
+    Setup installer.
+
+.EXAMPLE
+    powershell -ExecutionPolicy Bypass -File scripts\build.ps1 -Flavor lite
+    powershell -ExecutionPolicy Bypass -File scripts\build.ps1 -Flavor full
+#>
+param(
+    [Parameter(Mandatory = $true)]
+    [ValidateSet('lite', 'full')]
+    [string]$Flavor
+)
+
+$ErrorActionPreference = 'Stop'
+$Root = Split-Path -Parent $PSScriptRoot
+Set-Location $Root
+Write-Host "FPS Coach build - flavor: $Flavor" -ForegroundColor Cyan
+Write-Host "Project root: $Root"
+
+# --- 1. Virtual environment -------------------------------------------------
+if (-not (Test-Path ".venv")) {
+    py -3.11 -m venv .venv
+}
+$Py = Join-Path $Root ".venv\Scripts\python.exe"
+& $Py -m pip install --upgrade pip
+& $Py -m pip install -e ".[dev]"
+& $Py -m pip install "pyinstaller>=6"
+
+# --- 2. Stamp build flavor so the running app knows what it is ---------------
+$version = (& $Py -c "import tomllib,sys; print(tomllib.load(open('pyproject.toml','rb'))['project']['version'])").Trim()
+$embedded = if ($Flavor -eq 'full') { 'True' } else { 'False' }
+$model = if ($Flavor -eq 'full') { "'qwen3:1.7b'" } else { 'None' }
+@"
+# AUTO-GENERATED by scripts\build.ps1 - do not edit.
+BUILD_FLAVOR = "$Flavor"
+EMBEDDED_OLLAMA = $embedded
+EMBEDDED_MODEL = $model
+"@ | Set-Content -Encoding UTF8 (Join-Path $Root "python\fps_coach\build_info.py")
+
+# --- 3. Full flavor: stage the Ollama runtime + Qwen 3 1.7B weights ---------
+if ($Flavor -eq 'full') {
+    & (Join-Path $PSScriptRoot "fetch_ai_assets.ps1") -StageDir (Join-Path $Root "build\ai_assets")
+}
+
+# --- 4. Freeze the app with PyInstaller -------------------------------------
+$env:FPSCOACH_BUILD_FLAVOR = $Flavor
+& $Py -m PyInstaller --noconfirm --clean (Join-Path $Root "installer\fpscoach.spec")
+
+# --- 5. Compile the installer (Inno Setup) ----------------------------------
+$iss = if ($Flavor -eq 'full') { "installer\fpscoach-full.iss" } else { "installer\fpscoach-lite.iss" }
+$iscc = Get-Command iscc -ErrorAction SilentlyContinue
+if ($null -ne $iscc) {
+    & $iscc.Source "/DAppVersion=$version" "/DProjectRoot=$Root" (Join-Path $Root $iss)
+    Write-Host "Installer written to $Root\dist" -ForegroundColor Green
+} else {
+    Write-Warning "Inno Setup (iscc) not found on PATH. Frozen app is in '$Root\dist\FPSCoach'."
+    Write-Warning "Install Inno Setup 6, then run: iscc $iss"
+}
